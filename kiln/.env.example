# --- Application connection --------------------------------------------------
# Connects as kiln_app: owns nothing, inherits nothing, and can read no table
# until a request switches into one of the four role-specific database roles.
DATABASE_URL=postgres://kiln_app:CHANGE_ME@localhost:5432/kiln_dev

# --- Migration connection ----------------------------------------------------
# Needs to create roles and own tables. Never used to serve a request.
# On Neon this is the connection string for your project's owner role.
ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/kiln_dev

# Password the migration gives to kiln_app. Must match DATABASE_URL above.
KILN_APP_DB_PASSWORD=CHANGE_ME

# --- Sessions ----------------------------------------------------------------
# openssl rand -base64 32
AUTH_SECRET=CHANGE_ME

# --- Tests -------------------------------------------------------------------
# A separate database. The isolation suite creates and destroys organisations.
TEST_ADMIN_DATABASE_URL=postgres://postgres:CHANGE_ME@localhost:5432/kiln_test
TEST_DATABASE_URL=postgres://kiln_app:CHANGE_ME@localhost:5432/kiln_test
